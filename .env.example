# Copy to .env.local and fill in values (never commit secrets)

# Google Analytics 4 - client-side measurement (gtag)
# Create a GA4 property → Admin → Data streams → Web → Measurement ID (G-XXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-R9RCTZ6BK5

# Supabase (client)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ── Server-side only (Supabase Edge Function secrets - NOT VITE_) ────────────
# Used by supabase/functions/ga4-dashboard for the Admin Analytics dashboard.
# Set via: supabase secrets set KEY=value
#
# GA4_PROPERTY_ID=123456789
#   → GA4 Admin → Property settings → Property ID (numeric, not G-xxxx)
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=analytics-reader@PROJECT.iam.gserviceaccount.com
#   → Google Cloud Console → IAM → Service Accounts
#
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   → Service Account → Keys → Create JSON key → use the private_key field
#
# Also grant the service account Viewer access on the GA4 property
# (GA4 → Admin → Property access management).
# See supabase/functions/ga4-dashboard/README.md
