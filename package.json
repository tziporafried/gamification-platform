{
  "name": "gamification-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:offline && tsc -b && vite build",
    "build:offline": "vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "test:utm": "npx tsx --test src/lib/utmAttribution.test.ts",
    "test:offline": "node --import ./scripts/register-alias.mjs --test src/lib/offline/*.test.ts",
    "test:scan": "node --import ./scripts/register-alias.mjs --test src/lib/qrPayload.test.ts src/lib/scanSequence.test.ts src/lib/cardCounts.test.ts",
    "test:finance": "node --import ./scripts/register-alias.mjs --test src/lib/financeSplit.test.ts",
    "test:features": "node --import ./scripts/register-alias.mjs --test src/lib/eventFeatures.test.ts",
    "test:groups": "node --import ./scripts/register-alias.mjs --test src/lib/groups/*.test.ts",
    "test:lottery": "node --import ./scripts/register-alias.mjs --test src/components/live-events/lottery/*.test.ts",
    "test:manage": "node --import ./scripts/register-alias.mjs --test src/lib/manage/*.test.ts",
    "test:roster": "node --import ./scripts/register-alias.mjs --test src/lib/spreadsheet/*.test.ts src/lib/roster/*.test.ts src/lib/phone.test.ts",
    "test:sms": "node --import ./scripts/register-alias.mjs --test src/lib/smsTemplate.test.ts",
    "test:wizard": "node --import ./scripts/register-alias.mjs --test src/lib/wizardSteps.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
